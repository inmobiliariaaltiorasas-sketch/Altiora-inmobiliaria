# --- Docker / Postgres (usado por docker-compose.yml) ---
# Puerto 5434 por defecto: en esta máquina el 5432 ya lo usa otro proyecto (contenedor
# "lcj-postgres"). Si tu 5432 está libre, podés cambiarlo sin problema.
POSTGRES_USER=altiora
POSTGRES_PASSWORD=altiora
POSTGRES_DB=altiora_dev
POSTGRES_PORT=5434

# Copiar este archivo a apps/api/.env y apps/web/.env.local con los valores reales.
# Ver apps/api/.env.example y apps/web/.env.example para las variables por app.
